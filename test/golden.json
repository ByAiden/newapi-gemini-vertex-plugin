          "action": "text_to_video",
          "model": "video",
          "upstreamModel": "veo-3.1-lite-generate-001",
          "baseUrl": "https://aiplatform.googleapis.com",
          "apiKey": "test-key",
          "authHeader": "Bearer ya29.test",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public",
          "auth": {
            "projectId": "proj-1"
          }
