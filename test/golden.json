    {
      "name": "veo submits to us-central1 with the mapped model",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "prompt": "A boat",
            "resolution": "720p",
            "metadata": {
              "generateAudio": false
